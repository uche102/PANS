SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PSQL_URL=postgresql://postgres:your-database-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="PANS UniZik Election <verified-sender@example.com>"

# Optional: use Brevo API instead of SMTP.
# If BREVO_API_KEY is set, the API sender is used and SMTP_* is ignored.
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM="PANS UniZik Election <verified-sender@example.com>"

# Optional Brevo SMTP aliases, supported as an alternative to SMTP_* names.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_PASS=your-brevo-smtp-key

ADMIN_PASSWORD=PANS2026
ADMIN_SESSION_SECRET=replace-with-long-random-string
VOTER_SESSION_SECRET=replace-with-another-long-random-string
OTP_PEPPER=replace-with-long-random-string
CORS_ORIGIN=https://election-site-zeta.vercel.app,http://localhost:3000
COOKIE_SAMESITE=None
VITE_API_BASE_URL=https://your-render-backend.onrender.com

# Local testing only. Do not enable in Vercel production.
ALLOW_DEV_OTP=false
