{
  "version": 2,
  "builds": [
    {
      "src": "election-site/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/admin/:match*", "destination": "/index.html" },
    { "source": "/:match*", "destination": "/index.html" }
  ],
  "cleanUrls": true
}
